<Window
    x:Class="NetshWfpViewer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewModels="clr-namespace:NetshWfpViewer.ViewModels"
    xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
    xmlns:utilities="clr-namespace:NetshWfpViewer.Utilities"
    Title="WfpFiltersSearch"
    Width="800"
    Height="450"
    d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}"
    WindowState="Maximized"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBackgroundBrush}"
    TextElement.Foreground="{DynamicResource AppForegroundBrush}"
    mc:Ignorable="d">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style
            x:Key="TextEditorStyle"
            TargetType="avalonedit:TextEditor">
            <Setter Property="SyntaxHighlighting" Value="XML" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="10pt" />
            <Setter Property="Background" Value="{DynamicResource EditorBackgroundBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource EditorForegroundBrush}" />
            <Setter Property="LineNumbersForeground" Value="{DynamicResource EditorLineNumbersBrush}" />
        </Style>
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding
            Key="F5"
            Command="{Binding RefreshCommand}" />
    </Window.InputBindings>
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem
                    Header="[Left] Save"
                    Command="{Binding SaveLeftCommand}" />
                <MenuItem
                    Header="[Right] Save"
                    Command="{Binding SaveRightCommand}" />
            </MenuItem>
            <MenuItem Header="Filters">
                <MenuItem Header="Refresh">
                    <MenuItem
                        Header="Every 1s"
                        Command="{Binding RefreshCommand}"
                        CommandParameter="1" />
                    <MenuItem
                        Header="Every 5s"
                        Command="{Binding RefreshCommand}"
                        CommandParameter="5" />
                    <MenuItem
                        Header="Every 10s"
                        Command="{Binding RefreshCommand}"
                        CommandParameter="10" />
                    <MenuItem
                        Header="Every 30s"
                        Command="{Binding RefreshCommand}"
                        CommandParameter="30" />
                    <MenuItem
                        Header="Every 60s"
                        Command="{Binding RefreshCommand}"
                        CommandParameter="60" />
                    <MenuItem
                        Header="Stop"
                        Command="{Binding RefreshStopCommand}" />
                </MenuItem>
                <MenuItem
                    Header="Immediately Refresh (F5)"
                    Command="{Binding RefreshCommand}" />
            </MenuItem>
            <MenuItem Header="Theme">
                <MenuItem
                    x:Name="LightThemeMenuItem"
                    Header="Light"
                    IsCheckable="True"
                    Click="LightThemeMenuItem_Click" />
                <MenuItem
                    x:Name="DarkThemeMenuItem"
                    Header="Dark"
                    IsCheckable="True"
                    Click="DarkThemeMenuItem_Click" />
            </MenuItem>
        </Menu>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>

                <Border
                    DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0 0 0 2">
                    <Grid
                        DockPanel.Dock="Top"
                        Height="{Binding ElementName=HeaderStackPanel, Path=ActualHeight}"
                        Margin="3">
                        <TextBlock Margin="5 0">
                            cmd><Run
                                Text="{x:Static utilities:WfpExecutor.NetshCommand}"
                                FontWeight="Medium" />
                        </TextBlock>
                    </Grid>
                </Border>

                <avalonedit:TextEditor
                    x:Name="WfpFilters"
                    Style="{StaticResource TextEditorStyle}" />

            </DockPanel>

            <GridSplitter
                Grid.Column="1"
                Width="3"
                Margin="2 0"
                HorizontalAlignment="Center"
                VerticalAlignment="Stretch"
                Background="{DynamicResource AppBorderBrush}" />
            <DockPanel Grid.Column="2">
                <Border
                    DockPanel.Dock="Top"
                    BorderBrush="{DynamicResource AppBorderBrush}"
                    BorderThickness="0 0 0 2">
                    <Expander>
                        <Expander.Header>
                            <StackPanel
                                x:Name="HeaderStackPanel"
                                Orientation="Horizontal">
                                <TextBlock Text="Filters" />
                                <TextBlock
                                    Margin="10 0"
                                    Visibility="{Binding TimerWorks, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Run Text="Update in:" />
                                    <Run Text="{Binding TimerSecondsLeft}" />
                                    s. (Total:<Run Text="{Binding TimerTotalSeconds}" />
                                    s)</TextBlock>
                            </StackPanel>
                        </Expander.Header>
                        <DockPanel>
                            <DockPanel
                                Margin="5"
                                Dock="Top">
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    Width="165"
                                    Text="Item/Provider should have" />
                                <CheckBox
                                    x:Name="UserFilterAnyWordBox"
                                    DockPanel.Dock="Right"
                                    Content="Any word"
                                    IsChecked="{Binding UserFilterAnyWord}" />
                                <TextBox
                                    x:Name="UserFilterBox"
                                    Margin="5 0"
                                    Text="{Binding UserFilter, UpdateSourceTrigger=PropertyChanged}" />

                            </DockPanel>
                            <DockPanel
                                Margin="5"
                                Dock="Top">
                                <TextBlock
                                    DockPanel.Dock="Left"
                                    Width="165"
                                    Text="Item/Provider should haven't" />
                                <CheckBox
                                    DockPanel.Dock="Right"
                                    Content="Any word"
                                    IsChecked="{Binding UserInvertFilterAnyWord}" />
                                <TextBox
                                    Margin="5 0"
                                    Text="{Binding UserInvertFilter, UpdateSourceTrigger=PropertyChanged}" />
                            </DockPanel>
                        </DockPanel>
                    </Expander>
                </Border>
                <avalonedit:TextEditor
                    x:Name="FormattedWfpFilters"
                    Style="{StaticResource TextEditorStyle}" />
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
