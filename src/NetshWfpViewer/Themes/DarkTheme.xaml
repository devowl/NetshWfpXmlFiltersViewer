<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Application surfaces -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="AppForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="AppBorderBrush" Color="#3F3F46" />

    <!-- Menu -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="MenuForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="MenuItemHoverBrush" Color="#3E3E42" />
    <SolidColorBrush x:Key="MenuItemPressedBrush" Color="#26262B" />
    <SolidColorBrush x:Key="MenuSeparatorBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="MenuDisabledForegroundBrush" Color="#656565" />

    <!-- ScrollBars -->
    <SolidColorBrush x:Key="ScrollBarTrackBrush" Color="#252526" />
    <SolidColorBrush x:Key="ScrollBarThumbBrush" Color="#4E4E56" />
    <SolidColorBrush x:Key="ScrollBarThumbHoverBrush" Color="#6E6E78" />
    <SolidColorBrush x:Key="ScrollBarThumbPressedBrush" Color="#8A8A96" />

    <!-- AvalonEdit editors -->
    <SolidColorBrush x:Key="EditorBackgroundBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="EditorForegroundBrush" Color="#D4D4D4" />
    <SolidColorBrush x:Key="EditorLineNumbersBrush" Color="#858585" />

    <!-- XML syntax highlighting colors (VS Dark style), consumed by
         ThemeManager when building the dark variant of the AvalonEdit
         XML definition -->
    <sys:String x:Key="SyntaxColorComment">#6A9955</sys:String>
    <sys:String x:Key="SyntaxColorCData">#D4D4D4</sys:String>
    <sys:String x:Key="SyntaxColorDocType">#569CD6</sys:String>
    <sys:String x:Key="SyntaxColorXmlDeclaration">#D7BA7D</sys:String>
    <sys:String x:Key="SyntaxColorXmlTag">#569CD6</sys:String>
    <sys:String x:Key="SyntaxColorAttributeName">#9CDCFE</sys:String>
    <sys:String x:Key="SyntaxColorAttributeValue">#D7BA7D</sys:String>
    <sys:String x:Key="SyntaxColorEntity">#B5CEA8</sys:String>
    <sys:String x:Key="SyntaxColorBrokenEntity">#F44747</sys:String>

    <!-- System colors consumed by stock WPF control templates
         (TextBox, CheckBox, Expander, ...) via DynamicResource -->
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowBrushKey}" Color="#1E1E1E" />
    <SolidColorBrush x:Key="{x:Static SystemColors.WindowTextBrushKey}" Color="#D4D4D4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#D4D4D4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#D4D4D4" />
    <SolidColorBrush x:Key="{x:Static SystemColors.MenuBarBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#264F78" />
    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#FFFFFF" />
    <SolidColorBrush x:Key="{x:Static SystemColors.GrayTextBrushKey}" Color="#808080" />
    <SolidColorBrush x:Key="{x:Static SystemColors.ActiveBorderBrushKey}" Color="#3F3F46" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveBorderBrushKey}" Color="#3F3F46" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoBrushKey}" Color="#2D2D30" />
    <SolidColorBrush x:Key="{x:Static SystemColors.InfoTextBrushKey}" Color="#D4D4D4" />
</ResourceDictionary>
